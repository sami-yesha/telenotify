# ---- Domains (point both DNS A records at this server first) ----
API_DOMAIN=api.example.com
PORTAL_DOMAIN=app.example.com
# Let's Encrypt account email for HTTPS certificates.
ACME_EMAIL=you@example.com

# ---- Database ----
POSTGRES_PASSWORD=change-me-long-random

# ---- Secrets: generate new ones, never reuse local values ----
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up: losing it makes every connected live bot token unreadable.
ENCRYPTION_KEY=
SANDBOX_WEBHOOK_SECRET=

# ---- Shared sandbox bot (@BotFather) ----
SANDBOX_BOT_TOKEN=
SANDBOX_DAILY_MESSAGE_LIMIT=100
SANDBOX_LINKED_CUSTOMER_LIMIT=10

# ---- Telenotify Pass bot (@BotFather), optional ----
# Our own bot for one-tap verification. Leave empty to turn Pass off. Like every bot,
# only one server may use it: never put this token in a local .env.
PASS_BOT_TOKEN=
# openssl rand -hex 32 (letters and digits only)
PASS_WEBHOOK_SECRET=

# ---- Google sign-in ----
# Authorized redirect URI: https://<PORTAL_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (verification and password reset) ----
# e.g. smtps://user:password@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Telenotify <no-reply@example.com>

LINK_TOKEN_TTL_MINUTES=10080

# Operators (people running this Telenotify server): comma-separated emails that can
# open /admin to approve, suspend and raise limits, and that get review alerts.
OPERATOR_EMAILS=
# Optional: also alert operators on Telegram through the sandbox bot (press Start on it first).
OPERATOR_TELEGRAM_CHAT_ID=
# Live messages per day for organizations not yet approved by an operator.
UNAPPROVED_LIVE_DAILY_LIMIT=100
# Auto-suspend a live org when at least this many recipients block its bot in 24 hours...
AUTO_SUSPEND_MIN_BLOCKS=10
# ...and they are at least this share of the customers it messaged.
AUTO_SUSPEND_BLOCK_RATIO=0.3
