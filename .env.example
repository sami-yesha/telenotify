PORT=3000
DATABASE_URL=postgresql://telenotify:telenotify@localhost:5440/telenotify
REDIS_HOST=localhost
REDIS_PORT=6390

# Public HTTPS base URL of this API that Telegram can reach (ngrok/cloudflared locally).
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Developer portal origin; used in emails and auth redirects.
PORTAL_URL=http://localhost:3001
# Set to true when the portal is served over HTTPS.
COOKIE_SECURE=false

# Encrypts live bot tokens at rest. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared sandbox bot (create one with @BotFather). Leave empty to run without it;
# the test customers still work.
SANDBOX_BOT_TOKEN=
SANDBOX_WEBHOOK_SECRET=change-me-random-string
SANDBOX_DAILY_MESSAGE_LIMIT=100
SANDBOX_LINKED_CUSTOMER_LIMIT=10

# Google sign-in. Authorized redirect URI: ${PORTAL_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Leave SMTP_URL empty to print emails to the server log.
SMTP_URL=
MAIL_FROM=Telenotify <no-reply@example.com>

# How long a customer link token stays valid, in minutes.
LINK_TOKEN_TTL_MINUTES=10080

# Local development only: let webhook URLs point at localhost/private networks.
ALLOW_PRIVATE_WEBHOOK_URLS=false

# Which proxies may set X-Forwarded-For (rate limits use the client IP).
# "loopback" fits the portal proxy locally; in production use your load balancer hop count, e.g. 1.
TRUST_PROXY=loopback

# SMS price used to estimate "SMS money saved" in portal analytics.
SMS_REFERENCE_PRICE_ETB=0.2

# Messages per second per Telegram bot (Telegram allows about 30).
PER_BOT_MESSAGES_PER_SECOND=25

# Operators (people running this Telenotify server): comma-separated emails that can
# open /admin to approve, suspend and raise limits, and that get review alerts.
OPERATOR_EMAILS=
# Optional: also alert operators on Telegram through the sandbox bot (press Start on it first).
OPERATOR_TELEGRAM_CHAT_ID=
# Auto-suspend a live org when at least this many recipients block its bot in 24 hours...
AUTO_SUSPEND_MIN_BLOCKS=10
# ...and they are at least this share of the customers it messaged.
AUTO_SUSPEND_BLOCK_RATIO=0.3
