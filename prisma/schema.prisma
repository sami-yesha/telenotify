generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Portal users & auth ----------

model User {
  id              String    @id @default(uuid())
  email           String    @unique // stored lowercased
  name            String
  passwordHash    String?   // null for Google-only accounts
  googleSub       String?   @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  tokens      UserToken[]
  memberships Membership[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model UserToken {
  tokenHash String        @id
  userId    String
  type      UserTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------- Organizations ----------

enum Plan {
  FREE
  STARTER
  GROWTH
  BUSINESS
}

enum OrgStatus {
  ACTIVE
  // Every API key is rejected; set by an operator or by spam detection.
  SUSPENDED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  // Monthly live quota (messages + verifications); see src/billing/plans.ts.
  plan      Plan     @default(FREE)
  status          OrgStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  // Until an operator approves live use, live sending is capped per day
  // (UNAPPROVED_LIVE_DAILY_LIMIT) so a new account can test but not spam.
  liveApprovedAt     DateTime?
  liveReviewRequestedAt DateTime?
  // What the organization told us when asking for review.
  liveUseCase String?
  website     String?
  // "Verified business" badge: an operator checked the legal details below. Only
  // the hosted service can grant it, so customers can trust it.
  businessStatus       BusinessStatus @default(NONE)
  legalName            String?
  tin                  String?
  tradeLicense         String?
  businessRequestedAt  DateTime?
  businessVerifiedAt   DateTime?
  businessRejectReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  environments Environment[]
  invitations  Invitation[]
  auditEvents  AuditEvent[]
  usageAlerts  UsageAlert[]
  templates    MessageTemplate[]
}

enum BusinessStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum Role {
  OWNER
  MEMBER
}

model Membership {
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
}

// Email invitation to join an organization; accepted by a signed-in user with that email.
model Invitation {
  id          String    @id @default(uuid())
  orgId       String
  email       String // lowercased
  role        Role
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

enum EnvironmentType {
  SANDBOX
  LIVE
}

// Every organization has exactly one SANDBOX and one LIVE environment.
// All API data (keys, customers, messages) belongs to one environment.
model Environment {
  id                 String          @id @default(uuid())
  orgId              String
  type               EnvironmentType
  // LIVE only: the organization's own @BotFather bot. SANDBOX uses our shared bot.
  botTokenEncrypted  String?
  botUsername        String?
  // Random secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token (LIVE bots).
  webhookSecret      String
  eventWebhookUrl    String?
  eventSigningSecret String
  // Safe to put in a web page: it can only start "Verify with Telegram" sessions
  // (tn_pk_test_… / tn_pk_live_…), and in live only from allowedOrigins.
  publishableKey     String?         @unique
  allowedOrigins     String[]        @default([])
  // Bring-your-own SMS fallback (AfroMessage), paid by the organization. In the
  // sandbox it is simulated and needs no credentials.
  smsFallbackEnabled Boolean         @default(false)
  afroTokenEncrypted String?
  afroIdentifierId   String?
  afroSenderName     String?
  // Most fallback SMS in any 24 hours; null = no cap. Set by the organization so
  // a bug or a misuse of its token can only ever cost this much.
  smsDailyLimit      Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  customers     Customer[]
  linkTokens    LinkToken[]
  messages      Message[]
  verifications Verification[]
  deliveries    WebhookDelivery[]
  apiRequests   ApiRequestLog[]

  @@unique([orgId, type])
}

model ApiKey {
  id            String    @id @default(uuid())
  environmentId String
  name          String
  keyHash       String    @unique
  prefix        String
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  environment Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  requests    ApiRequestLog[]

  @@index([environmentId])
}

// One row per authenticated public API call, kept for 30 days.
model ApiRequestLog {
  id            String   @id @default(uuid())
  environmentId String
  apiKeyId      String
  method        String
  path          String
  statusCode    Int
  durationMs    Int
  error         String?
  ip            String?
  createdAt     DateTime @default(now())

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  apiKey      ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([environmentId, createdAt])
  @@index([apiKeyId, createdAt])
}

// ---------- Messaging ----------

// One end user of an organization, identified by the organization's own ID for them.
model Customer {
  id               String    @id @default(uuid())
  environmentId    String
  externalId       String
  phone            String?
  telegramChatId   String?
  telegramUsername String?
  // Preferred language for templates: en | am | om | ti.
  locale           String?
  linkedAt         DateTime?
  // Set when the customer blocks the bot; cleared if they /start again.
  blockedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([environmentId, externalId])
  @@index([environmentId, telegramChatId])
  @@index([environmentId, phone])
  @@index([telegramChatId])
}

// Single-use token carried in t.me/<bot>?start=<token> to connect a chat to a customer.
model LinkToken {
  token         String    @id
  environmentId String
  externalId    String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, externalId])
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum MessagePriority {
  NORMAL
  // Queued ahead of NORMAL messages: OTPs, payment and transaction alerts.
  HIGH
}

enum MessageStatus {
  QUEUED
  SENT
  // Telegram cannot reach this customer; the caller should use its own fallback.
  UNDELIVERABLE
  // Telegram kept failing or rejected the message.
  FAILED
  RECEIVED
}

enum MessageFormat {
  PLAIN
  MARKDOWN
}

enum FallbackStatus {
  QUEUED
  SENT
  FAILED
  // Fallback is on but not sent: no phone number, or the daily SMS limit was reached.
  SKIPPED
}

model Message {
  id                String        @id @default(uuid())
  environmentId     String
  customerId        String
  direction         Direction
  status            MessageStatus
  priority          MessagePriority @default(NORMAL)
  // Set when the text came from a template.
  templateKey       String?
  locale            String?
  // not_linked | blocked | chat_gone | telegram_unavailable | telegram_rejected
  reason            String?
  text              String
  // MARKDOWN: text uses Telenotify formatting (sent as Telegram HTML, plain for SMS).
  format            MessageFormat @default(PLAIN)
  // [[{ text, url }]] rows of inline URL buttons.
  buttons           Json?
  idempotencyKey    String?
  telegramMessageId String?
  error             String?
  // false when the caller opted this message out of SMS fallback.
  smsFallback       Boolean         @default(true)
  fallbackStatus    FallbackStatus?
  fallbackError     String?
  // AfroMessage's message id, or "simulated" in the sandbox.
  fallbackProviderId String?
  fallbackAt        DateTime?
  attempts          Int           @default(0)
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([environmentId, idempotencyKey])
  @@index([environmentId, createdAt])
  @@index([environmentId, status])
  @@index([environmentId, fallbackAt])
}

// ---------- Phone verification ----------

enum VerificationStatus {
  // Link created, not opened yet.
  PENDING
  // Opened in Telegram; waiting for the person to share their phone number.
  AWAITING_CONTACT
  VERIFIED
  FAILED
  EXPIRED
}

// "Verify with Telegram": the person shares their own contact with the bot, and
// Telegram vouches that the phone number belongs to that account. No SMS, no code.
model Verification {
  id             String             @id @default(uuid())
  environmentId  String
  // Carried in t.me/<bot>?start=v_<token>.
  token          String             @unique
  // Optional: link this customer to the chat once verified.
  externalId     String?
  // Optional: fail unless the shared number matches (normalized).
  expectedPhone  String?
  status         VerificationStatus @default(PENDING)
  // phone_mismatch | not_own_contact
  reason         String?
  phone          String?
  telegramUserId String?
  telegramChatId String?
  expiresAt      DateTime
  verifiedAt     DateTime?
  // Hosted verify page: where to send the person afterwards, or the site whose
  // popup receives the result (postMessage).
  returnUrl      String?
  origin         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, createdAt])
  @@index([telegramChatId, status])
}

// ---------- Webhook delivery log ----------

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// One row per event sent to an organization's webhook URL. Its id is the event id
// (x-telenotify-event-id), so receivers and the portal refer to the same thing.
model WebhookDelivery {
  id            String         @id
  environmentId String
  event         String
  payload       Json
  // Set for message.* events, to show them on the message detail page.
  messageId     String?
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  // [{ at, statusCode?, error?, durationMs }], newest last.
  attemptLog    Json           @default("[]")
  lastStatusCode Int?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, createdAt])
  @@index([messageId])
}

// ---------- Audit log & usage alerts ----------

// Who did what in an organization. actorEmail is kept so entries stay readable after
// the user is deleted; actor is null for operator actions (e.g. plan changes).
model AuditEvent {
  id          String   @id @default(uuid())
  orgId       String
  actorUserId String?
  actorEmail  String?
  action      String
  // Human-readable subject, e.g. a key name, an email, a bot username.
  target      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// Remembers which quota alert emails were sent, so each goes out once per month.
model UsageAlert {
  id        String   @id @default(uuid())
  orgId     String
  // Billing period, "YYYY-MM" in UTC.
  period    String
  // Percent of quota: 80 or 100.
  threshold Int
  sentAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, period, threshold])
}

// ---------- Templates ----------

// Reusable message text with per-language variants and {{placeholders}}. Shared by
// an organization's sandbox and live environments.
model MessageTemplate {
  id            String   @id @default(uuid())
  orgId         String
  // Used in the API: { "template": "payment_received" }
  key           String
  name          String
  description   String?
  // { "en": "...", "am": "..." }
  variants      Json
  defaultLocale String   @default("en")
  format        MessageFormat @default(PLAIN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}
