# Copy to .env (Docker) or .env.local (npm run dev) and fill in.

# An API key from the Telenotify portal. tn_test_… works for trying it out; the public
# demo uses tn_live_… with its own bot.
TELENOTIFY_API_KEY=

# The signing secret from the portal's Webhooks page (same environment as the key).
TELENOTIFY_SIGNING_SECRET=

# Telenotify's API address.
TELENOTIFY_API_URL=https://telenotify-api.duckdns.org

# Where this demo is reachable. Buttons in Telegram messages link here (https only).
DEMO_PUBLIC_URL=https://telenotify-demo.duckdns.org
